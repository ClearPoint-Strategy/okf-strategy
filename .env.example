# okf-strategy/.env.example — NON-SECRET CONFIG ONLY.
# Scope: this repo's runtime contract, taken from app code (tooling excluded).
# Build scripts, one-off probes and test fixtures are deliberately EXCLUDED —
# they are not part of what the service needs to run.
# Secrets are never committed; they are injected by `op run --environment ...`.

ACCOUNT_DIR=   # optional, fallback = "account"
BUNDLE_TITLE=   # optional, fallback = "Upward Airlines"
CLEARPOINT_API_URL=   # no value on record
OUT_BUNDLE=   # optional, fallback = "upward-airlines"
