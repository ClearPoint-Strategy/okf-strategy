{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://clearpointstrategy.com/cps-okf/element-status.schema.json",
    "title": "cps-okf — Element statuses payload",
    "description": "Array of native ClearPoint element statuses (api/v1/doc/schema/elementStatus.json). Period-scoped updates to existing elements: statusId, analysis & recommendations (first-class, not custom fields), percentComplete, costs, dates. Custom field VALUES are NOT set here — they go in a separate customFieldData payload. Every entry MUST carry scorecardId and periodId.",
    "type": "object",
    "additionalProperties": false,
    "required": ["statuses"],
    "properties": {
        "statuses": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["object", "scorecardId", "periodId"],
                "properties": {
                    "object": {
                        "type": "string",
                        "enum": [
                            "objective",
                            "measure",
                            "initiative",
                            "milestone",
                            "actionItem",
                            "risk"
                        ]
                    },
                    "objectId": {
                        "type": ["integer", "null"],
                        "description": "Existing element id. null when below confidence threshold (see _map + envelope.unresolved)."
                    },
                    "ref": {
                        "type": "string",
                        "description": "Alternatively target an element created earlier in this run."
                    },
                    "scorecardId": { "type": ["integer", "null"] },
                    "periodId": {
                        "type": ["integer", "null"],
                        "description": "Reporting period. If null, envelope defaults.periodId applies."
                    },
                    "statusId": { "type": ["integer", "null"] },
                    "analysis": {
                        "type": "string",
                        "description": "HTML narrative."
                    },
                    "recommendations": {
                        "type": "string",
                        "description": "HTML narrative."
                    },
                    "percentComplete": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "plannedCost": { "type": ["number", "null"] },
                    "actualCost": { "type": ["number", "null"] },
                    "forecastCost": { "type": ["number", "null"] },
                    "currentStartDate": {
                        "type": ["string", "null"],
                        "format": "date"
                    },
                    "currentEndDate": {
                        "type": ["string", "null"],
                        "format": "date"
                    },
                    "completed": { "type": "boolean" },
                    "completedDate": { "type": "string", "format": "date" },
                    "tags": { "type": "array", "items": { "type": "integer" } },
                    "_map": { "$ref": "common.schema.json#/$defs/map" }
                }
            }
        }
    }
}
