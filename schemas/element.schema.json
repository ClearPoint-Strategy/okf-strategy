{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://clearpointstrategy.com/cps-okf/element.schema.json",
    "title": "cps-okf — Elements payload",
    "description": "Array of native ClearPoint elements (api/v1/doc/schema/element.json). Covers ALL object types — scorecard, category, objective, measure, initiative, milestone, actionItem, risk — so setup creation and edits use one shape. New objects carry a `ref` (no objectId yet) and link to others by `*Ref`; existing objects carry objectId. Every non-scorecard element MUST carry scorecardId or scorecardRef.",
    "type": "object",
    "additionalProperties": false,
    "required": ["elements"],
    "properties": {
        "elements": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["object", "name"],
                "properties": {
                    "object": {
                        "$ref": "common.schema.json#/$defs/objectType"
                    },
                    "ref": {
                        "type": "string",
                        "description": "Local slug for a NEW element; targeted by other refs and by linkedElements / measureSeries / measureData."
                    },
                    "objectId": {
                        "type": ["integer", "null"],
                        "description": "Existing element id (edit). Omit/null for creation."
                    },
                    "name": { "type": "string", "maxLength": 500 },
                    "scorecardId": {
                        "type": ["integer", "null"],
                        "description": "Owning scorecard (existing). Required for non-scorecard objects unless scorecardRef is used."
                    },
                    "scorecardRef": {
                        "type": "string",
                        "description": "Owning scorecard minted in this batch."
                    },
                    "parentId": {
                        "type": ["integer", "string", "null"],
                        "description": "Parent element (hierarchy)."
                    },
                    "parentRef": { "type": ["string", "null"] },
                    "ownerId": { "type": ["integer", "null"] },
                    "measureId": {
                        "type": ["integer", "null"],
                        "description": "For shadow/linked measures."
                    },
                    "initiativeId": {
                        "type": ["integer", "null"],
                        "description": "Parent initiative for a MILESTONE (existing). Required for milestones (use initiativeRef for one minted in this batch)."
                    },
                    "initiativeRef": {
                        "type": "string",
                        "description": "Parent initiative minted in this batch, for a MILESTONE."
                    },
                    "periodGroupId": { "type": ["integer", "null"] },
                    "startDate": {
                        "type": "string",
                        "format": "date",
                        "description": "REQUIRED for initiative / milestone / actionItem (time-bound). If the source omits it, default to the plan term or push to unresolved — do not create a dateless time-bound element."
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date",
                        "description": "REQUIRED for initiative / milestone / actionItem (time-bound). See startDate."
                    },
                    "completed": { "type": "boolean" },
                    "completedDate": { "type": "string", "format": "date" },
                    "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                    },
                    "baselineCost": { "type": ["number", "null"] },
                    "sortOrder": { "type": "integer" },
                    "tags": { "type": "array", "items": { "type": "integer" } },
                    "categories": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "description": "Category ids this element belongs to (objectives)."
                    },
                    "_map": { "$ref": "common.schema.json#/$defs/map" }
                },
                "allOf": [
                    {
                        "if": {
                            "required": ["object"],
                            "properties": {
                                "object": { "not": { "const": "scorecard" } }
                            }
                        },
                        "then": {
                            "anyOf": [
                                { "required": ["scorecardId"] },
                                { "required": ["scorecardRef"] }
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": ["object"],
                            "properties": {
                                "object": {
                                    "enum": ["initiative", "milestone", "actionItem"]
                                }
                            }
                        },
                        "then": {
                            "required": ["startDate", "endDate"],
                            "_comment": "Initiatives, milestones, and action items are time-bound — start and end dates are required. When the source omits them, the parser must supply them (e.g. default to the plan term) or push the reference to unresolved; it must not create a dateless time-bound element."
                        }
                    },
                    {
                        "if": {
                            "required": ["object"],
                            "properties": { "object": { "const": "milestone" } }
                        },
                        "then": {
                            "anyOf": [
                                { "required": ["initiativeId"] },
                                { "required": ["initiativeRef"] }
                            ],
                            "_comment": "A milestone belongs to a parent initiative — it must carry initiativeId (existing) or initiativeRef (minted in this batch). In the execution plan this becomes the initiativeId in the POST /initiatives/{id}/milestones path."
                        }
                    }
                ]
            }
        }
    }
}
