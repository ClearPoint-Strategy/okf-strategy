{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://clearpointstrategy.com/cps-okf/measure-series.schema.json",
    "title": "cps-okf — Measure series payload",
    "description": "Array of native ClearPoint measure series DEFINITIONS (api/v1/doc/schema/measureSeriesInput.json). Each series belongs to a measure (measureRef for a measure created in this run, or measureId for an existing one). Numeric values are NOT here — they go in the measureData payload.",
    "type": "object",
    "additionalProperties": false,
    "required": ["series"],
    "properties": {
        "series": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "seriesDataTypeId"],
                "properties": {
                    "ref": {
                        "type": "string",
                        "description": "Local slug for this series; targeted by measureData."
                    },
                    "measureRef": {
                        "type": "string",
                        "description": "Parent measure minted in this run."
                    },
                    "measureId": {
                        "type": ["integer", "null"],
                        "description": "Parent measure, existing."
                    },
                    "objectId": {
                        "type": ["integer", "null"],
                        "description": "Existing series id (edit)."
                    },
                    "name": { "type": "string", "maxLength": 50 },
                    "seriesDataTypeId": {
                        "type": "integer",
                        "enum": [4, 5, 6, 8, 9, 10, 11],
                        "description": "Series data type. Confirmed values: 4=Currency, 5=Number, 6=Percentage, 8=Accounting, 9=Integer, 10=Custom, 11=Text. Resolved from manifest referenceData.seriesDataTypes."
                    },
                    "numberFormatId": {
                        "type": "integer",
                        "description": "Resolved from manifest referenceData.numberFormats."
                    },
                    "currency": { "type": "string" },
                    "aggregateType": {
                        "type": "string",
                        "enum": ["STDEV", "AVERAGE", "SUM", "COUNT"]
                    },
                    "calculation": { "type": "string" },
                    "sortOrder": { "type": "integer" },
                    "tags": { "type": "array", "items": { "type": "integer" } },
                    "_map": { "$ref": "common.schema.json#/$defs/map" }
                },
                "anyOf": [
                    { "required": ["measureId"] },
                    { "required": ["measureRef"] }
                ],
                "_comment": "A series belongs to a measure — it must carry measureId (existing) or measureRef (minted in this batch)."
            }
        }
    }
}
